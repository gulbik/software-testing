{
  "name": "playwright",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI test suite for practicesoftwaretesting.com",
  "private": true,
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:ci": "tsc --noEmit && playwright test"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "^5.5.3"
  }
}
